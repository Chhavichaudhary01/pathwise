# PathWise Environment Configuration Example

# Backend Configuration (Spring Boot)
# Port: 4444
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>:5432/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# AI Keys (Free Tier Providers)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIzaSy...

# JWT Configuration
JWT_SECRET=your-512-bit-secret-key-at-least-64-characters-long-for-production-security
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth2 (Optional for local testing)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Configuration
VITE_API_URL=http://localhost:4444/api/v1
